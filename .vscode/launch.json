{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LangGraph dev (serve :2024)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/langgraph",
      "args": ["dev"],
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "LangGraph dev (debug-port 5678, then attach)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/langgraph",
      "args": ["dev", "--no-browser", "--debug-port", "5678"],
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Attach to LangGraph dev (5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "pathMappings": [
        { "localRoot": "${workspaceFolder}", "remoteRoot": "${workspaceFolder}" }
      ]
    },
    {
      "name": "Load generation: local (150)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/load_generation.py",
      "args": ["--mode", "local", "--n", "150"],
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Load generation: local (small, 5)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/load_generation.py",
      "args": ["--mode", "local", "--n", "5"],
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Load generation: remote (prompts for URL)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/load_generation.py",
      "args": ["--mode", "remote", "--n", "150", "--url", "${input:deploymentUrl}"],
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Setup Context Hub",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.setup_context_hub",
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Teardown Context Hub (dry run)",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.teardown_context_hub",
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Teardown Context Hub (--yes, DELETES)",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.teardown_context_hub",
      "args": ["--yes"],
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "deploymentUrl",
      "type": "promptString",
      "description": "Deployed LangSmith assistant URL",
      "default": "https://<your-deployment>.us.langgraph.app"
    }
  ]
}
